include
    Type.string-constraints
    Type.numeric-constraints

features
    Sandwich
        mandatory
            Bread
            String Name        // typed features
            Integer Slices
        optional
            Cheese
            Sauce
                alternative
                    Ketchup
                    Mustard

constraints
    Ketchup => Cheese
    len(Name) <= 20             // string constraint
    Slices >= 2
